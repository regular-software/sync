{
  "name": "basic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server/index.ts --port 3001",
    "dev:web": "vite --port 3000",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --external:better-sqlite3 --outfile=dist/server.js",
    "preview": "pnpm build && pnpm start",
    "start": "node dist/server.js --port 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@keyline-icons/react": "^0.1.4",
    "@regular-software/sync": "workspace:*",
    "@regular-software/sync-browser": "workspace:*",
    "@regular-software/sync-protocol": "workspace:*",
    "@regular-software/sync-react-query": "workspace:*",
    "@regular-software/sync-drizzle": "workspace:*",
    "@regular-software/sync-hono": "workspace:*",
    "@regular-software/sync-server": "workspace:*",
    "@tanstack/react-query": "latest",
    "@tanstack/react-table": "^9.2.3",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "latest",
    "hono": "^4.13.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
